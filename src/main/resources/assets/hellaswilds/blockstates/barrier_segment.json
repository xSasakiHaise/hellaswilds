{
  "multipart": [
    { "apply": { "model": "minecraft:block/glass_pane_post" } },
    { "when": { "north": "true" }, "apply": { "model": "minecraft:block/glass_pane_side" } },
    { "when": { "east": "true" }, "apply": { "model": "minecraft:block/glass_pane_side", "y": 90 } },
    { "when": { "south": "true" }, "apply": { "model": "minecraft:block/glass_pane_side", "y": 180 } },
    { "when": { "west": "true" }, "apply": { "model": "minecraft:block/glass_pane_side", "y": 270 } },
    {
      "when": { "north": "false", "east": "false", "south": "false", "west": "false" },
      "apply": { "model": "minecraft:block/glass_pane_noside" }
    },
    {
      "when": { "north": "false", "east": "false", "south": "false", "west": "false" },
      "apply": { "model": "minecraft:block/glass_pane_noside_alt" }
    }
  ]
}
